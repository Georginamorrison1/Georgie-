# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HiBob service user credentials
# Create a service user in HiBob: Settings > Integrations > Service Users
HIBOB_SERVICE_USER_ID=your_hibob_service_user_id
HIBOB_SERVICE_USER_TOKEN=your_hibob_service_user_token

# Recruitment tool — SQLite database file path (defaults to recruitment.db)
DATABASE_PATH=recruitment.db

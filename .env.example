# Airtable configuration
# Get your API token from: https://airtable.com/create/tokens
AIRTABLE_API_TOKEN=your_personal_access_token_here

# Your Airtable Base ID (found in the base URL: airtable.com/appXXXXXXXXXXXX)
AIRTABLE_BASE_ID=appXXXXXXXXXXXX

# The name or ID of the table you want to work with
AIRTABLE_TABLE_NAME=Table 1

# Greenhouse Harvest API credentials
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Required: your Greenhouse Harvest API key
# Greenhouse > Configure > Dev Center > API Credential Management > Create New API Key (type: Harvest)
GREENHOUSE_API_KEY=

# Optional: your Greenhouse user ID (required only for adding notes to candidates)
# Find it in the URL when viewing your profile: greenhouse.io/users/YOUR_ID
GREENHOUSE_ON_BEHALF_OF=
